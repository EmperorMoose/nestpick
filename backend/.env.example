# Copy to .env and fill in values

# Database — defaults to backend/house_dashboard.db locally, /data/house_dashboard.db on Railway
# DATABASE_URL=sqlite+aiosqlite:////data/house_dashboard.db

# Walk Score API key (free at https://www.walkscore.com/professional/api.php)
WALKSCORE_API_KEY=

# Extra CORS origins for production (comma-separated)
# CORS_ORIGINS=["https://your-railway-app.up.railway.app"]
